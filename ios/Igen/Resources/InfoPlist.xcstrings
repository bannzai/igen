      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "igen uses the microphone so you can speak your worries instead of typing them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "igen は、お悩みをキーボードの代わりに声で話せるよう、マイクを使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "igen saves your share card image to your photo library when you choose to."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "igen は、保存を選んだときに共有カードの画像をフォトライブラリに保存します。"
          }
        }
      }
    },
