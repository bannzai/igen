          "stringUnit" : {
            "state" : "translated",
            "value" : "igen converts your voice to text to fill in your consultation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "igen は、相談の入力を埋めるために音声をテキストに変換します。"
