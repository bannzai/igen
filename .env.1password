# 1Password secret references: op run --env-file .env.1password -- <command> が環境変数として渡す。
# 値は書かない。op://<vault>/<item>/<field> の参照だけを書く。
REVENUECAT_API_KEY=op://igen/REVENUECAT_API_KEY/password
REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2=op://igen/REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2/password
