{
  "name": "igen-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "firebase emulators:exec --project demo-igen --only firestore \"vitest run\"",
    "seed": "npm run build && node lib/seed.js",
    "serve": "npm run build && firebase emulators:start --project demo-igen --only auth,functions,firestore"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "openai": "^7.33.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "firebase-tools": "^15.33.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
