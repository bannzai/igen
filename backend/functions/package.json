{
  "name": "igen-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "firebase emulators:exec --project demo-igen --only firestore \"vitest run\"",
    "serve": "npm run build && firebase emulators:start --project demo-igen --only functions,firestore"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "firebase-tools": "^15.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
