{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5201
    },
    "firestore": {
      "port": 8282
    },
    "hub": {
      "port": 4402
    },
    "logging": {
      "port": 4502
    },
    "ui": {
      "enabled": false
    }
  }
}
